{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": [
    {
      "target": "student",
      "public": "dist-sites/student",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/sitemap.xml",
          "function": {
            "functionId": "servePublicSitemap",
            "region": "us-central1"
          }
        },
        {
          "source": "/sitemap-core.xml",
          "function": {
            "functionId": "servePublicSitemap",
            "region": "us-central1"
          }
        },
        {
          "source": "/sitemap-papers-*.xml",
          "function": {
            "functionId": "servePublicSitemap",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-paper-data/**",
          "function": {
            "functionId": "servePublicPaperData",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-paper-catalog",
          "function": {
            "functionId": "servePublicPaperCatalogData",
            "region": "us-central1"
          }
        },
        {
          "source": "/papers",
          "function": {
            "functionId": "servePublicPaperSeo",
            "region": "us-central1"
          }
        },
        {
          "source": "/papers/**",
          "function": {
            "functionId": "servePublicPaperSeo",
            "region": "us-central1"
          }
        },
        {
          "source": "/policies",
          "destination": "/policies.html"
        },
        {
          "source": "**",
          "destination": "/app.html"
        }
      ]
    },
    {
      "target": "tutor",
